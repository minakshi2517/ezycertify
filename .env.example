# Razorpay Dashboard → Settings → API Keys
# Use test keys (rzp_test_...) while developing.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx

# Optional. Leave empty in local Vite dev (API is served at /api).
# For a split frontend/backend deploy, set the backend origin.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
VITE_API_URL=

PORT=5000
