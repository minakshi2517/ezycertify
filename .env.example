# ============================================================
# EZYCERTIFY PRODUCTION / DEVELOPMENT CONFIGURATION
# ============================================================

# Server Port & Mode
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5174

# Session & JWT Configuration (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=ezycertify_dev_jwt_secret_change_in_production_987654321
COOKIE_SECRET=ezycertify_dev_cookie_secret_change_in_production_123456789
SESSION_EXPIRES_IN=7d

# Default Admin Credentials (Auto-seeded if no admin exists)
ADMIN_DEFAULT_EMAIL=admin@ezycertify.com
ADMIN_DEFAULT_PASSWORD=Admin@Ezycertify2026!
ADMIN_DEFAULT_NAME=Ezycertify Master Administrator
ADMIN_DEFAULT_PHONE=+919876543210

# Razorpay API Credentials (TEST Mode: rzp_test_... / LIVE Mode: rzp_live_...)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# Frontend Razorpay Key & Backend API URL (for Vite client)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
VITE_API_URL=

# Email / SMTP Configuration (Optional in Dev - falls back to formatted console logger)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Ezycertify" <support@ezycertify.com>

# SMS / Phone OTP Provider (Optional in Dev - falls back to formatted console logger)
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=EZYCRT
